.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Downloaded and generated artifacts --------------------------------------
srslist.h
artifacts.tgz
go.zip
qt.7z
openssl.7z
*.zip
*.7z
*.tar
