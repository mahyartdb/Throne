# Runtime artifacts of the Go core — written next to the binary when it runs.
config.json
*.log
*.pem
*.db
*.dat

# Build output of `go build` / `go test`.
*.exe
*.test

# Generated protobuf sources — regenerate with script/build_go.sh.
server/gen/*.pb.go
server/gen/*.pb.*.go

# Test fixtures are source, never artifacts.
!**/testdata/**
